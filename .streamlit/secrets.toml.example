# For Streamlit Cloud deployment — paste your Firebase service account JSON fields here
# Go to Streamlit Cloud → App Settings → Secrets and paste the contents of this file
# (with real values from config/firebase-credentials.json)

[FIREBASE_CREDENTIALS]
type = "service_account"
project_id = "mscm-5591c"
private_key_id = "YOUR_KEY_ID"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
client_email = "firebase-adminsdk-xxxxx@mscm-5591c.iam.gserviceaccount.com"
client_id = "123456789"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
